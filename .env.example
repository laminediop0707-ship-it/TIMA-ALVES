# ============================================================
#  Estère Adousinda Alves — birthday site
#  Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Birthday Surprise"

# --- Database (PostgreSQL) -----------------------------------
# Development: embedded-postgres listens on the port below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tima_birthday?schema=public"

# --- Security ------------------------------------------------
# openssl rand -base64 48  (min 32 chars). Rotating it logs everyone out.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
SESSION_TTL_HOURS=12
SURPRISE_TTL_HOURS=24
# Set to true when the site is served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# --- Admin bootstrap (read once by scripts/bootstrap-admin.mjs) -----
# Temporary credentials. The first login forces a password change.
ADMIN_USERNAME=lemzo
ADMIN_BOOTSTRAP_PASSWORD=lemzo-change-me

# --- Surprise gate -------------------------------------------
# Full name the birthday girl must type. Compared server-side only.
SURPRISE_NAME="Estère Adousinda Alves"

# --- Media storage -------------------------------------------
# Uploaded files are stored OUTSIDE /public and streamed by an API route.
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Local development Postgres (scripts/dev-postgres.mjs) ----
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tima_birthday
